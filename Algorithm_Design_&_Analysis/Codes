int min_coins(int *coins, int n, int amount) {
int dp[amount + 1];
for (int i = 0; i <= amount; i++) dp[i] = amount + 1;
dp[0] = 0;
for (int i = 1; i <= amount; i++)
for (int j = 0; j < n; j++)
if (coins[j] <= i) dp[i] = min(dp[i], 1 + dp[i - coins[j]]);
return dp[amount] > amount ? -1 : dp[amount];
}
int main() {
int coins1[] = {1, 5, 6, 9};
cout << min_coins(coins1, 4, 11) << endl;
int coins2[] = {2};
cout << min_coins(coins2, 1, 3) << endl;
int coins3[] = {1, 2, 5};
cout << min_coins(coins3, 3, 11) << endl;
return 0;
}
