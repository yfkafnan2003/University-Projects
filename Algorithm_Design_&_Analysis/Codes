#include <climits>
using namespace std;
typedef struct { int src, dest, weight; } Edge;
void bellman_ford(int V, int E, Edge *edges, int src) {
int dist[V];
for (int i = 0; i < V; i++) dist[i] = INT_MAX / 2;
dist[src] = 0;
for (int i = 1; i <= V - 1; i++) {
for (int j = 0; j < E; j++) {
int u = edges[j].src, v = edges[j].dest, weight = edges[j].weight;
if (dist[u] != INT_MAX / 2 && dist[u] + weight < dist[v])
dist[v] = dist[u] + weight;
}
}
for (int j = 0; j < E; j++) {
int u = edges[j].src, v = edges[j].dest, weight = edges[j].weight;
if (dist[u] != INT_MAX / 2 && dist[u] + weight < dist[v]) {
cout << "Graph contains a negative-weight cycle" << endl;
return;
}
}
cout << "Vertex Distance from Source" << endl;
for (int i = 0; i < V; i++) cout << i << " " << dist[i] << endl;
}
int main() {
int V = 5, E = 10;
Edge edges[] = {
{0, 1, 6}, {0, 2, 7}, {1, 2, 8}, {1, 3, 5},
{1, 4, -4}, {2, 3, -3}, {2, 4, 9}, {3, 1, -2},
{4, 0, 2}, {4, 3, 7}
};
bellman_ford(V, E, edges, 0);
return 0;
}
