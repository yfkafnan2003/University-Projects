int count_ways(int *coins, int n, int amount) {
int dp[amount + 1];
for (int i = 0; i <= amount; i++) dp[i] = 0;
dp[0] = 1;
for (int i = 0; i < n; i++)
for (int j = coins[i]; j <= amount; j++)
dp[j] += dp[j - coins[i]];
return dp[amount];
}
int main() {
int coins1[] = {1, 2, 3};
cout << count_ways(coins1, 3, 4) << endl;
int coins2[] = {2, 5, 3, 6};
cout << count_ways(coins2, 4, 10) << endl;
