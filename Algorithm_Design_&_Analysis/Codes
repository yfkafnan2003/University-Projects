#include <iostream>
#include <vector>
#include <algorithm>
#include <iomanip>
using namespace std;
typedef struct { int weight; int value; } Item;
double fractional_knapsack(Item *items, int n, int capacity) {
vector<pair<double, int>> ratios;
for (int i = 0; i < n; i++) ratios.push_back({(double)items[i].value / items[i].weight,
i});
sort(ratios.begin(), ratios.end(), greater<pair<double, int>>());
double total_value = 0.0;
for (int i = 0; i < n; i++) {
int idx = ratios[i].second;
if (capacity >= items[idx].weight) {
total_value += items[idx].value;
capacity -= items[idx].weight;
} else {
total_value += items[idx].value * ((double)capacity / items[idx].weight);
break;
}
}
return total_value;
}
int main() {
Item items1[] = {{10, 60}, {20, 100}, {30, 120}};
cout << fixed << setprecision(2) << fractional_knapsack(items1, 3, 50) << endl;
Item items2[] = {{5, 50}, {10, 60}, {15, 90}};
cout << fixed << setprecision(2) << fractional_knapsack(items2, 3, 20) << endl;
return 0;
}
