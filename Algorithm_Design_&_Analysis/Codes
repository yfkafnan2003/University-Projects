int find_kth_largest(int *arr, int size, int k) {
for (int i = 0; i < k; ++i) {
for (int j = 0; j < size - i - 1; ++j) {
if (arr[j] > arr[j + 1]) {
swap(arr[j], arr[j + 1]);
}
}
}
return arr[size - k];
}
int main() {
int arr1[] = {3, 1, 7, 4, 9, 2};
int size1 = sizeof(arr1) / sizeof(arr1[0]);
