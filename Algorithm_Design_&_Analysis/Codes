int knapsack_01(int *weights, int *values, int n, int W) {
int dp[n + 1][W + 1];
for (int i = 0; i <= n; i++) {
for (int w = 0; w <= W; w++) {
if (i == 0 || w == 0) dp[i][w] = 0;
else if (weights[i - 1] <= w)
dp[i][w] = max(values[i - 1] + dp[i - 1][w - weights[i - 1]], dp[i - 1][w]);
else dp[i][w] = dp[i - 1][w];
}
}
return dp[n][W];
}
int main() {
int weights1[] = {2, 3, 4, 5}, values1[] = {3, 4, 5, 6};
cout << knapsack_01(weights1, values1, 4, 5) << endl;
int weights2[] = {1, 3, 4, 5}, values2[] = {1, 4, 5, 7};
cout << knapsack_01(weights2, values2, 4, 7) << endl;
return 0;
}
